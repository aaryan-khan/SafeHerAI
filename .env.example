# Copy this file to `.env` and fill in LOCAL values.
# `.env` is gitignored. Never put real secrets in this example file.

# --- Local PostgreSQL (used from Milestone 1) ---
POSTGRES_DB=safeherai
POSTGRES_USER=safeherai
POSTGRES_PASSWORD=change-me-local-only
# Host port for the local DB. Change it (e.g. 5433) if 5432 is already in use.
DB_PORT=5432

# --- Alerts (Milestone 8) ---
# dry_run = record alerts but send NOTHING. Default for all development.
ALERTS_MODE=dry_run

# --- Routing (Milestone 7) ---
ORS_API_KEY=